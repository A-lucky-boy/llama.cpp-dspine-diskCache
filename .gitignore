# Deployment output
#
# output/ is the build target (CMakeLists.txt points the runtime and library
# output directories at it) and the deployment layout. It is kept in the tree as
# an empty directory so a fresh clone can build straight into it.

/output/*
!/output/.gitkeep
*.pdb
*.ilk
*.exp
*.lib

# The build scripts the docs refer to; the generic *.bat rule above would
# otherwise hide them
!/build-cuda-shared.bat
!/experiments/*.bat
!/test-run/*.bat

# Local pre-change backups (see the project workflow rules)
/.backupChange/

# Test harness scratch space. The scripts themselves are kept (they are the
# reproduction harness for the cache work), but everything the runs produce is
# local: raw logs (*.log is already ignored above), and the generated
# continuations, which are derived from the local test corpus and must not be
# published.
/test-run/logs/out-*.txt
/test-run/cache-*/
/test-run/*.exe
/test-run/hold*.py

